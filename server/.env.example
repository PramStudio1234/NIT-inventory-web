# ===================================
# ตั้งค่า Local SMTP สำหรับส่งอีเมลแจ้งเตือนภายในสถาบัน (สำหรับย้ายระบบจริง)
# ===================================
SMTP_HOST=smtp.neuro.go.th
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=nit-inventory@neuro.go.th

# ===================================
# ตั้งค่า Gmail / Brevo สำหรับส่งอีเมลแจ้งเตือน (กรณีใช้ระบบคลาวด์/สำรอง)
# ===================================
# 1. ใช้ Gmail หรือ API Key ของ Brevo
# 2. กรณีใช้ Gmail ให้สร้าง App Password แล้วนำมาใส่ที่ GMAIL_PASS
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx
BREVO_API_KEY=

# ===================================
# ตั้งค่า Server
# ===================================
PORT=3001

# อนุญาตให้ Frontend เรียกได้จาก URL ไหนบ้าง (ใส่ * ถ้าทดสอบ local)
ALLOWED_ORIGINS=*
