# ===================================
# ตั้งค่า Gmail สำหรับส่งอีเมลแจ้งเตือน
# ===================================
# 1. ใช้ Gmail ของคุณ
# 2. ไปที่ https://myaccount.google.com/apppasswords
# 3. สร้าง App Password แล้วนำมาใส่ที่ GMAIL_PASS

GMAIL_USER=your-email@gmail.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# ===================================
# ตั้งค่า Server
# ===================================
PORT=3001

# อนุญาตให้ Frontend เรียกได้จาก URL ไหนบ้าง (ใส่ * ถ้าทดสอบ local)
ALLOWED_ORIGINS=*
